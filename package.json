{
  "name": "career-crox-render-stable",
  "private": true,
  "version": "1.0.49",
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "render-build": "node scripts/render-use-prebuilt-spa.mjs && node scripts/render-safe-install.mjs backend",
    "build": "npm run render-build",
    "start": "node backend/server.js",
    "start:render": "node backend/server.js",
    "local:setup": "npm install --prefix backend",
    "local:backend": "npm run dev --prefix backend",
    "postinstall": "node -e \"console.log('Career Crox root install complete. Render build installs backend and prepares SPA.');\""
  }
}
